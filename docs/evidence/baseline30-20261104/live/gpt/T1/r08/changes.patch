+import re
+
+
+_PHONE_PATTERNS = [
+    re.compile(r'(?<!\d)(01[016789])[- ]?(\d{4})[- ]?(\d{4})(?!\d)'),
+    re.compile(r'(?<!\d)(0\d{1,2})[- ]?(\d{3,4})[- ]?(\d{4})(?!\d)'),
+]
+
+
 def mask_phone(text):
-    return text
+    def _replace(match):
+        return f"{match.group(1)}-{match.group(2)[0]}***-{match.group(3)}"
+
+    masked = text
+    for pattern in _PHONE_PATTERNS:
+        masked = pattern.sub(_replace, masked)
+    return masked
