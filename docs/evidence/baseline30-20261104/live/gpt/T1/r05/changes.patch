@@ -1,2 +1,21 @@
+import re
+
+
+_PHONE_PATTERNS = [
+    re.compile(r'(?<!\d)(\d{3})-(\d{4})-(\d{4})(?!\d)'),
+    re.compile(r'(?<!\d)(\d{3})(\d{4})(\d{4})(?!\d)'),
+]
+
+
+def _mask_match(match):
+    groups = match.groups()
+    if len(groups) == 3:
+        return f"{groups[0]}-****-{groups[2]}"
+    return f"{groups[0]}****{groups[2]}"
+
+
 def mask_phone(text):
-    return text
+    result = text
+    for pattern in _PHONE_PATTERNS:
+        result = pattern.sub(_mask_match, result)
+    return result
