+import re
+
+
+_PHONE_PATTERN = re.compile(r'(?<!\d)(01[016789]|02|0[3-6][1-5]|0[7-9][0-9])-?\d{3,4}-?\d{4}(?!\d)')
+
+
 def mask_phone(text):
-    return text
+    def _mask(match):
+        phone = match.group(0)
+        digits = re.sub(r'\D', '', phone)
+        if len(digits) < 10:
+            return phone
+        if len(digits) == 10:
+            return digits[:6] + '****'
+        return digits[:7] + '****'
+
+    return _PHONE_PATTERN.sub(_mask, text)
