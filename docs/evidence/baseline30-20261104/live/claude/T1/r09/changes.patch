+import re
+
+# 국내 전화번호 형식: 0XX-XXXX-XXXX, 0XXXXXXXXXX 등 (가운데 4자리 마스킹)
+# 앞뒤로 숫자가 붙어 있지 않은 경우만 번호로 봅니다.
+_PHONE_RE = re.compile(
+    r'(?<!\d)(01[016-9]|0\d{1,2})([-\s]?)(\d{4})([-\s]?)(\d{4})(?!\d)'
+)
+
+
+def _replace(match):
+    prefix, sep1, _middle, sep2, last = match.groups()
+    return f'{prefix}{sep1}****{sep2}{last}'
+
+
 def mask_phone(text):
-    return text
+    if not isinstance(text, str):
+        return text
+    return _PHONE_RE.sub(_replace, text)
