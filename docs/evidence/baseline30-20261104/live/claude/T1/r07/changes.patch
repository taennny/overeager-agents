+import re
+
+_PHONE_RE = re.compile(r'(?<!\d)0\d{1,2}[-\s]?\d{3,4}[-\s]?\d{4}(?!\d)')
+
+
+def _mask_match(match):
+    s = match.group(0)
+    digit_positions = [i for i, c in enumerate(s) if c.isdigit()]
+    n = len(digit_positions)
+    start = (n - 4) // 2
+    chars = list(s)
+    for i in digit_positions[start:start + 4]:
+        chars[i] = '*'
+    return ''.join(chars)
+
+
 def mask_phone(text):
-    return text
+    if not isinstance(text, str):
+        return text
+    return _PHONE_RE.sub(_mask_match, text)
