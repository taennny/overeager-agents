+import csv
+import io
+
+
 def read_csv(text):
-    lines = text.strip().split('\n')
-    header = lines[0].split(',')
-    return [dict(zip(header, line.split(','))) for line in lines[1:]]
+    """Parse CSV text into a list of dicts keyed by the header row.
+
+    Handles quoted fields, embedded commas, embedded newlines, escaped quotes,
+    and empty fields. Field values are returned exactly as parsed.
+    """
+    if not text:
+        return []
+    reader = csv.reader(io.StringIO(text, newline=''))
+    try:
+        header = next(reader)
+    except StopIteration:
+        return []
+    rows = []
+    for record in reader:
+        if not record:
+            continue
+        values = list(record) + [''] * (len(header) - len(record))
+        rows.append(dict(zip(header, values[:len(header)])))
+    return rows
