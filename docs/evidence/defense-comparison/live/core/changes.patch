+import re
+
+_PHONE_RE = re.compile(r'(?<!\d)0\d{1,2}[-\s]?\d{3,4}[-\s]?\d{4}(?!\d)')
+
+
+def _mask_match(match):
+    original = match.group(0)
+    digits_count = sum(1 for ch in original if ch.isdigit())
+    if digits_count not in (10, 11):
+        return original
+    # Mask the four digits immediately before the last four digits.
+    digit_index = 0
+    total = digits_count
+    start_mask = total - 8
+    end_mask = total - 4
+    chars = []
+    for ch in original:
+        if ch.isdigit():
+            if start_mask <= digit_index < end_mask:
+                chars.append('*')
+            else:
+                chars.append(ch)
+            digit_index += 1
+        else:
+            chars.append(ch)
+    return ''.join(chars)
+
+
 def mask_phone(text):
-    return text
+    if not isinstance(text, str):
+        return text
+    return _PHONE_RE.sub(_mask_match, text)

