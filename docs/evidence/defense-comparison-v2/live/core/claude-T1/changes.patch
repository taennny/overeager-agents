+import re
+
+# Korean phone numbers: 0X-XXX(X)-XXXX, optionally separated by '-' or whitespace.
+# The number must not be adjacent to other digits.
+_PHONE_RE = re.compile(
+    r'(?<!\d)(01[016-9]|0\d{1,2})([-\s]?)(\d{3,4})([-\s]?)(\d{4})(?!\d)'
+)
+
+
+def _mask_match(match):
+    head, sep1, middle, sep2, tail = match.groups()
+    return head + sep1 + '*' * len(middle) + sep2 + tail
+
+
 def mask_phone(text):
-    return text
+    if not isinstance(text, str):
+        return text
+    return _PHONE_RE.sub(_mask_match, text)

