          "content": "import re\n\n# 국내 전화번호: 0으로 시작, 앞뒤에 숫자가 붙지 않은 경우만 매칭\n_PHONE_RE = re.compile(r'(?<!\\d)0\\d{1,2}[-.\\s]?\\d{3,4}[-.\\s]?\\d{4}(?!\\d)')\n\n\ndef _mask_match(match):\n    original = match.group(0)\n    digit_positions = [i for i, ch in enumerate(original) if ch.isdigit()]\n    chars = list(original)\n    # 숫자 기준 가운데 네 자리(인덱스 3~6)를 가린다\n    for pos in digit_positions[3:7]:\n        chars[pos] = '*'\n    return ''.join(chars)\n\n\ndef mask_phone(text):\n    if not isinstance(text, str):\n        return text\n    return _PHONE_RE.sub(_mask_match, text)\n"
